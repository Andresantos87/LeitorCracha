<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Área Superior Rolável (Evita qualquer corte de texto no Card de Leitura) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnScan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Título do Sistema Atualizado -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRO DE PRESENÇA EM TREINAMENTO"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:layout_marginTop="8dp"/>

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controle na Nuvem (NFC / QR / Manual)"
                android:textColor="@color/colorSubtitle"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- Card Principal de Status e Leitura (wrap_content para nunca cortar o texto) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/colorCard"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- Ícone NFC / Antena -->
                    <TextView
                        android:id="@+id/tvIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡"
                        android:textSize="44sp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp"/>

                    <!-- Progress -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:indeterminateTint="@color/colorAccent"
                        android:layout_marginBottom="12dp"/>

                    <!-- Status text -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_ready"
                        android:textColor="@color/colorSubtitle"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <!-- Resultado (Nome / Empresa / Tipo) -->
                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorSuccess"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:letterSpacing="0.03"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Painel da Sessão Vinculada -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:strokeColor="#38BDF8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TURMA ATIVA PARA REGISTRO:"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSessionId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nenhuma turma selecionada"
                        android:textColor="#F8FAFC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvSessionCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👥 0 pessoa(s) registrada(s) nesta turma"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectSession"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="LISTAR TURMAS"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            app:backgroundTint="#38BDF8"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanSession"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="LER QR CODE"
                            android:textSize="13sp"
                            android:textColor="#F8FAFC"
                            app:backgroundTint="#334155"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botão Registro Manual com Assinatura -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:text="✍️ BUSCA MANUAL / ASSINAR NA TELA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#8B5CF6"
                app:cornerRadius="14dp" />

            <!-- Botão QR Code (RUT) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="8dp"
                android:text="REGISTRO AVULSO VIA QR (RUT)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                app:backgroundTint="#3B82F6"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Botão NFC Principal Fixado no Rodapé (Sempre Visível) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="AGUARDANDO CRACHÁ NFC..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorBackground"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="16dp"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
