<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeColor="#38BDF8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Cabeçalho -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✍️ REGISTRO MANUAL &amp; ASSINATURA"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Busque no banco ou digite manualmente e assine na tela"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- Seção 1: Busca -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. BUSCAR COLABORADOR (NOME OU MATRÍCULA)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:paddingHorizontal="14dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:hint="Ex: Tales, ou 1024..."/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchColab"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="BUSCAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    app:backgroundTint="#38BDF8"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Dica: Se não encontrar, preencha os dados abaixo"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginBottom="16dp"/>

            <!-- Seção 2: Dados Editáveis -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. DADOS DO COLABORADOR (EDITÁVEIS)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome Completo *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etNomeColaborador"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E293B"
                android:paddingHorizontal="14dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="14sp"
                android:inputType="textPersonName|textCapWords"
                android:hint="Digite o nome completo"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empresa / Planta (Busque na lista ou digite) *"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <AutoCompleteTextView
                android:id="@+id/actvEmpresa"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E293B"
                android:paddingHorizontal="14dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="14sp"
                android:inputType="textCapCharacters"
                android:hint="Ex: CMPC, TERCEIRA, METSA..."
                android:completionThreshold="1"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matrícula / CPF / ID (Opcional)"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etIdColaborador"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E293B"
                android:paddingHorizontal="14dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="14sp"
                android:hint="Ex: 10240, 000.000.000-00..."
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginBottom="16dp"/>

            <!-- Seção 3: Assinatura na Tela -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3. ASSINE COM O DEDO NO QUADRO ABAIXO *"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <Button
                    android:id="@+id/btnClearSig"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🧹 Limpar"
                    android:textColor="#F87171"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/llSignatureContainer"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Botões de Ação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelManual"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="CANCELAR"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E2E8F0"
                    app:backgroundTint="#334155"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmManual"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.3"
                    android:layout_marginStart="6dp"
                    android:text="CONFIRMAR E ASSINAR"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#0284C7"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
